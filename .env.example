# 값은 절대 여기에 넣지 마세요. 로컬은 .env.local, 배포는 Netlify 환경변수에만 넣습니다.

# Gemini 분석 (선택 — 없으면 규칙 기반 폴백)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Amazon Polly 결과 읽기.
# 반드시 POLLY_AWS_* 이름을 사용하세요 — AWS_* 이름은 Netlify(Lambda)가 자체 값을
# 자동 주입하는 예약 이름이라 사용자가 설정할 수 없고, 코드도 읽지 않습니다.
POLLY_AWS_ACCESS_KEY_ID=
POLLY_AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명일 때만 채우세요(영구 키면 비워둡니다)
POLLY_AWS_SESSION_TOKEN=
# 비우면 ap-northeast-2 (서울)
POLLY_AWS_REGION=
# 비우면 Seoyeon / neural
POLLY_VOICE_ID=
POLLY_ENGINE=
